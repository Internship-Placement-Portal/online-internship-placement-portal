NODE_ENV=development
PORT=5000

# MongoDB (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/ipp

# JWT access tokens (max 60 minutes per IPP-SR-002). Use a long random string.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_MIN=15

# Refresh tokens
REFRESH_TOKEN_EXPIRES_DAYS=7

# Allowed browser origin for CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# bcrypt cost factor
BCRYPT_ROUNDS=12

# Admin seed (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@ipp.local
ADMIN_PASSWORD=ChangeMe123!

# Optional: comma-separated DNS servers for Node (fixes mongodb+srv lookups on some networks)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Resume uploads (local disk in development)
# UPLOAD_DIR=./uploads
# RATE_LIMIT_UPLOAD_MAX=10
# Optional ClamAV daemon for malware scanning of uploads
# CLAMAV_HOST=
# CLAMAV_PORT=3310

# Email delivery. Without SMTP_HOST, development prints mails (OTPs, reset links) to the server console.
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for implicit TLS on port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="IPP <no-reply@your-domain>"

# TLS (IPP-SR-001). Either terminate TLS in Node...
# TLS_CERT_FILE=/etc/ssl/ipp/fullchain.pem
# TLS_KEY_FILE=/etc/ssl/ipp/privkey.pem
# ...or run behind a TLS-terminating proxy and trust it:
# TRUST_PROXY=true
# FORCE_HTTPS=true           # default on in production
# JOBS_ENABLED=true          # set false on all but one instance when scaling out
