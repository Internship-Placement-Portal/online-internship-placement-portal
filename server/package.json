{
  "name": "ipp-server",
  "version": "1.0.0",
  "private": true,
  "description": "IPP REST API (Express + Mongoose)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --require ./tests/setup.js --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:demo": "node src/scripts/seedDemo.js",
    "test:coverage": "c8 --check-coverage --lines 40 --functions 40 --branches 40 node --require ./tests/setup.js --test --test-concurrency=1 \"tests/**/*.test.js\" && npm run coverage:core",
    "coverage:core": "c8 check-coverage --lines 40 --functions 40 --branches 40 --include \"src/**/auth*.js\" --include \"src/**/application*.js\" --include \"src/**/notification*.js\" --include \"src/**/test*.js\" --include \"src/**/attempt*.js\" --include \"src/**/scoring*.js\" --include \"src/**/question*.js\" --include \"src/**/storage*.js\" --include \"src/**/scan*.js\" --include \"src/**/resumeValidation.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.2",
    "winston": "^3.19.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
