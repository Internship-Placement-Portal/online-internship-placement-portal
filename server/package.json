{
  "name": "ipp-server",
  "version": "1.0.0",
  "private": true,
  "description": "IPP REST API (Express + Mongoose)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
